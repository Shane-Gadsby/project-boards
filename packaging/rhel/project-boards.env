# Project Boards settings. After changing this: systemctl restart project-boards
# The address people and pb use, with no trailing slash. pb treats it as home and upgrades from it. Required.
PB_PUBLIC_URL=https://boards.example.com
# Loopback, with HAProxy in front for TLS. To serve directly (no TLS), use 0.0.0.0 and open the port.
# To serve under a sub-path, include it in PB_PUBLIC_URL and uncomment this.
#PB_BASE_PATH=/projects
PB_HOST=127.0.0.1
PB_PORT=4780
PB_DATA=/var/lib/project-boards
# Pinned, so the Access page cannot turn logins off. Set the password with project-boards-admin set-password.
PB_AUTH=required
